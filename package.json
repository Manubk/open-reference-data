{
  "name": "open-reference-data",
  "version": "1.0.0",
  "description": "Open reference datasets for JavaScript and TypeScript applications",
  "author": "Manubk",
  "license": "MIT",
  "homepage": "https://github.com/Manubk/open-reference-data#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manubk/open-reference-data.git"
  },
  "bugs": {
    "url": "https://github.com/Manubk/open-reference-data/issues"
  },
  "keywords": [
    "reference-data",
    "countries",
    "currencies",
    "banks",
    "iso",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./countries": {
      "types": "./dist/countries/index.d.ts",
      "import": "./dist/countries/index.js",
      "require": "./dist/countries/index.cjs",
      "default": "./dist/countries/index.js"
    },
    "./currencies": {
      "types": "./dist/currencies/index.d.ts",
      "import": "./dist/currencies/index.js",
      "require": "./dist/currencies/index.cjs",
      "default": "./dist/currencies/index.js"
    },
    "./banks": {
      "types": "./dist/banks/index.d.ts",
      "import": "./dist/banks/index.js",
      "require": "./dist/banks/index.cjs",
      "default": "./dist/banks/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:countries": "tsx scripts/validate-countries.ts",
    "validate:currencies": "tsx scripts/validate-currencies.ts",
    "validate:banks": "tsx scripts/validate-banks.ts",
    "validate:data": "npm run validate:countries && npm run validate:currencies && npm run validate:banks",
    "build": "npm run clean && tsup",
    "prepack": "npm run validate:data && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
